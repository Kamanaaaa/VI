@model IEnumerable<BookCrudApp.Models.Book>

<h1>Books List</h1>

<p>
    <a asp-action="Create">Create New Book</a>
</p>

<table style="border-collapse: collapse; width: 80%;">
    <thead>
        <tr>
            <th style="border: 1px solid black; padding: 8px;">ID</th>
            <th style="border: 1px solid black; padding: 8px;">Title</th>
            <th style="border: 1px solid black; padding: 8px;">Author</th>
            <th style="border: 1px solid black; padding: 8px;">Price</th>
            <th style="border: 1px solid black; padding: 8px;">Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="border: 1px solid black; padding: 8px;">@item.Id</td>
                <td style="border: 1px solid black; padding: 8px;">@item.Title</td>
                <td style="border: 1px solid black; padding: 8px;">@item.Author</td>
                <td style="border: 1px solid black; padding: 8px;">@item.Price</td>
                <td style="border: 1px solid black; padding: 8px;">
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>